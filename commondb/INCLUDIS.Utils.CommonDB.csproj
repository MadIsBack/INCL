<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>INCLUDIS.Utils.CommonDB</RootNamespace>
    <AssemblyName>INCLUDIS.Utils.CommonDB</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS0168;CS0219;CS0649;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms-/Designer-Dateien ausschliessen (nicht .NET 8 / WindowsDesktop-kompatibel) -->
    <Compile Remove="CommonDbControl.cs" />
    <Compile Remove="CommonDbControl.Designer.cs" />
    <Compile Remove="Properties\Resources.Designer.cs" />
    <Compile Remove="Properties\Settings.Designer.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="Properties\**\*.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="CommonDbControl.resx" />
    <None Remove="Properties\*.resx" />
    <None Remove="Properties\*.settings" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="System.CodeDom" Version="8.0.0" />
  </ItemGroup>
</Project>
